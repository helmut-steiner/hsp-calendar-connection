msgstr "Die folgenden Verbindungseinstellungen, die Kalenderauswahl und die Statusangaben gehören zu %1$s."

#: hsp-calendar-connection.php:1417
msgid "Create an employee in Amelia before setting up a calendar connection."
msgstr "Legen Sie in Amelia einen Mitarbeiter an, bevor Sie eine Kalenderverbindung einrichten."

#: hsp-calendar-connection.php:1472
msgid "Default calendar timezone"
msgstr "Standardzeitzone des Kalenders"

#: hsp-calendar-connection.php:1450
msgid "Discover calendars"
msgstr "Kalender suchen"

#: hsp-calendar-connection.php:1375
msgid "Discovery completed, but no calendar collections were found."
msgstr "Die Suche wurde abgeschlossen, aber es wurden keine Kalendersammlungen gefunden."

