msgstr "No se ha podido verificar la disponibilidad del calendario. Póngase en contacto con nosotros para concertar su cita."

#: includes/class-hspcc-busy-time.php:156
msgid "Calendar availability could not be verified. Please try again or send an enquiry."
msgstr "No se ha podido verificar la disponibilidad del calendario. Inténtelo de nuevo o envíe una consulta."

