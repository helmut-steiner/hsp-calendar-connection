msgid "Connection settings, calendar choices and status below belong to %1$s."
msgstr "Los ajustes de conexión, la selección de calendarios y el estado que aparecen a continuación pertenecen a %1$s."

#: hsp-calendar-connection.php:1406
msgid "Connection status"
msgstr "Estado de la conexión"

#: hsp-calendar-connection.php:1455
msgid "Create an employee in Amelia before setting up a calendar connection."
msgstr "Cree un empleado en Amelia antes de configurar una conexión de calendario."

#: hsp-calendar-connection.php:1540
msgid "Default calendar timezone"
msgstr "Zona horaria predeterminada del calendario"

#: hsp-calendar-connection.php:1504
msgid "Discover calendars"
msgstr "Buscar calendarios"

#: hsp-calendar-connection.php:1415
msgid "Discovery completed, but no calendar collections were found."
msgstr "Se ha completado la búsqueda, pero no se han encontrado colecciones de calendarios."

