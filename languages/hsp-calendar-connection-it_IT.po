#: hsp-calendar-connection.php:1395
#, php-format
msgid "Employee %1$d (not available in Amelia)"
msgstr "Dipendente %1$d (non disponibile in Amelia)"

#: hsp-calendar-connection.php:441
msgid "Enter a valid CalDAV username. Credentials were not changed."
msgstr "Inserisci un nome utente CalDAV valido. Le credenziali non sono state modificate."

#: hsp-calendar-connection.php:435
msgid "Enter a valid HTTPS CalDAV server URL and Amelia employee ID. Connection settings were not changed."
msgstr "Inserisci un URL HTTPS valido del server CalDAV e un ID dipendente Amelia valido. Le impostazioni di connessione non sono state modificate."

#: hsp-calendar-connection.php:1421
msgid "Enter a valid calendar timezone, such as Europe/Vienna."
msgstr "Inserisci un fuso orario valido per il calendario, ad esempio Europe/Vienna."

#: hsp-calendar-connection.php:467
msgid "Enter the CalDAV password for the initial connection."
msgstr "Inserisci la password CalDAV per la connessione iniziale."

#: hsp-calendar-connection.php:451
msgid "Enter the password for the new CalDAV server. A saved password is never forwarded automatically to a different server."
msgstr "Inserisci la password per il nuovo server CalDAV. Una password salvata non viene mai inoltrata automaticamente a un server diverso."

#: hsp-calendar-connection.php:1420
msgid "Existing managed appointments must be migrated before changing the booking destination."
msgstr "Gli appuntamenti gestiti esistenti devono essere migrati prima di cambiare la destinazione delle prenotazioni."

#: hsp-calendar-connection.php:1610
msgid "Failed; please check the connection."
msgstr "Verifica non riuscita; controlla la connessione."

#: hsp-calendar-connection.php:1123
msgid "Forbidden."
msgstr "Accesso vietato."

#: includes/class-hspcc-sync-queue.php:86
msgid "HSP calendar retry (five minutes)"
msgstr "Nuovo tentativo del calendario HSP (cinque minuti)"

#: hsp-calendar-connection.php:1603
msgid "If the destination is also checked, this employee’s managed entries are excluded from their external busy periods; Amelia checks those appointments itself. Other employees’ entries remain busy."
msgstr "Se è selezionato anche il calendario di destinazione, le voci gestite di questo dipendente sono escluse dai suoi periodi occupati esterni; Amelia verifica autonomamente tali appuntamenti. Le voci degli altri dipendenti restano occupate."

#. translators: %s: Date and time of the last availability check.
#: hsp-calendar-connection.php:1609
#, php-format
msgid "Last availability check: %1$s"
msgstr "Ultima verifica della disponibilità: %1$s"

#: hsp-calendar-connection.php:1496
msgid "No password is stored."
msgstr "Non è memorizzata alcuna password."

#: hsp-calendar-connection.php:1610
msgid "Passed."
msgstr "Verifica riuscita."

#: includes/class-hspcc-amelia.php:77
msgid "Please contact us to arrange this change or a recurring appointment."
msgstr "Contattaci per organizzare questa modifica o un appuntamento ricorrente."

#: includes/class-hspcc-amelia.php:103
msgid "Please contact us to arrange this paid or custom session."
msgstr "Contattaci per organizzare questa sessione a pagamento o personalizzata."

#: includes/class-hspcc-updater.php:105
msgid "Private CalDAV busy-time checks and Amelia appointment writeback, with one connection per employee."
msgstr "Verifica privata degli orari occupati CalDAV e scrittura degli appuntamenti Amelia nel calendario, con una connessione per dipendente."

#: hsp-calendar-connection.php:header
msgid "Private CalDAV busy-time checks and Amelia appointment writeback."
msgstr "Verifica privata degli orari occupati CalDAV e scrittura degli appuntamenti Amelia nel calendario."

#: hsp-calendar-connection.php:1526
msgid "Read busy times from"
msgstr "Leggi gli orari occupati da"

#: hsp-calendar-connection.php:1556
msgid "Remove test event"
msgstr "Rimuovi evento di prova"

#: hsp-calendar-connection.php:455
msgid "Remove the temporary test event before replacing the saved password."
msgstr "Rimuovi l’evento di prova temporaneo prima di sostituire la password salvata."

#: hsp-calendar-connection.php:447
msgid "Resolve managed appointments, pending sync jobs and temporary tests before changing the server, account or employee. Connection settings were not changed."
msgstr "Risolvi gli appuntamenti gestiti, le attività di sincronizzazione in attesa e i test temporanei prima di cambiare server, account o dipendente. Le impostazioni di connessione non sono state modificate."

#: hsp-calendar-connection.php:1405
msgid "Runtime settings"
msgstr "Impostazioni di funzionamento"

#: hsp-calendar-connection.php:1424
msgid "Runtime settings could not be saved."
msgstr "Non è stato possibile salvare le impostazioni di funzionamento."

#: hsp-calendar-connection.php:1425
msgid "Runtime settings saved."
msgstr "Le impostazioni di funzionamento sono state salvate."

#: hsp-calendar-connection.php:1517 hsp-calendar-connection.php:1579 hsp-calendar-connection.php:1599
msgid "Save a connection and discover calendars first."
msgstr "Salva prima una connessione e cerca i calendari."

#: hsp-calendar-connection.php:1541
msgid "Save calendar choices"
msgstr "Salva selezione dei calendari"

#: hsp-calendar-connection.php:1499
msgid "Save connection"
msgstr "Salva connessione"

#: hsp-calendar-connection.php:1587
msgid "Save runtime settings"
msgstr "Salva impostazioni di funzionamento"

#: hsp-calendar-connection.php:1409
msgid "Saved credentials are unavailable. Enter or replace them, then try again."
msgstr "Le credenziali salvate non sono disponibili. Inseriscile o sostituiscile, quindi riprova."

#: hsp-calendar-connection.php:462
msgid "Secure credential storage is unavailable. Credentials were not changed."
msgstr "L’archiviazione sicura delle credenziali non è disponibile. Le credenziali non sono state modificate."

#: hsp-calendar-connection.php:157 hsp-calendar-connection.php:1458
msgid "Settings"
msgstr "Impostazioni"

#: hsp-calendar-connection.php:1444
msgid "Show employee"
msgstr "Mostra dipendente"

#: hsp-calendar-connection.php:1566
msgid "Some appointment entries need attention. Saved jobs are retained for recovery."
msgstr "Alcune voci degli appuntamenti richiedono attenzione. Le attività salvate vengono conservate per consentire il recupero."

#: hsp-calendar-connection.php:1586
msgid "Store Amelia appointments in the selected destination"
msgstr "Salva gli appuntamenti Amelia nella destinazione selezionata"

#: hsp-calendar-connection.php:1532
msgid "Store Amelia bookings in"
msgstr "Salva le prenotazioni Amelia in"

#: hsp-calendar-connection.php:1605
msgid "Supported on Amelia 9.9.1: individual fixed-duration free appointments and capacity-one fixed-price appointments with on-site payment. Customer rescheduling requires the same service, employee and location. Online payments, packages, recurring appointments and other reassignment flows are not supported."
msgstr "Supportati in Amelia 9.9.1: appuntamenti individuali gratuiti a durata fissa e appuntamenti a prezzo fisso per una persona con pagamento in loco. Lo spostamento da parte del cliente richiede lo stesso servizio, dipendente e luogo. Pagamenti online, pacchetti, appuntamenti ricorrenti e altre riassegnazioni non sono supportati."

#: hsp-calendar-connection.php:1430
msgid "Temporary event cleanup completed. Successful create/update verification now permits appointment storage."
msgstr "La pulizia dell’evento temporaneo è completata. La verifica riuscita della creazione e dell’aggiornamento consente ora il salvataggio degli appuntamenti."

#: hsp-calendar-connection.php:1556
msgid "Test write access"
msgstr "Prova accesso in scrittura"

#: hsp-calendar-connection.php:1426
msgid "Test write access and remove the temporary event before enabling appointment storage."
msgstr "Prova l’accesso in scrittura e rimuovi l’evento temporaneo prima di attivare il salvataggio degli appuntamenti."

#: includes/class-hspcc-amelia.php:78
msgid "That time is no longer available. Please choose another time."
msgstr "Questo orario non è più disponibile. Scegli un altro orario."

#: includes/class-hspcc-amelia-sync.php:329
msgid "The appointment could not be prepared for calendar synchronization."
msgstr "Non è stato possibile preparare l’appuntamento per la sincronizzazione con il calendario."

#: hsp-calendar-connection.php:1410
msgid "The calendar server could not be reached or returned an unsupported response."
msgstr "Il server del calendario non è raggiungibile o ha restituito una risposta non supportata."

#: includes/class-hspcc-endpoint.php:179
msgid "The calendar server request could not be completed safely."
msgstr "Non è stato possibile completare in sicurezza la richiesta al server del calendario."

#: hsp-calendar-connection.php:1602
msgid "The checked calendars block availability. A separate destination receives Amelia appointment entries when storage is enabled. Slot displays may use a validated result for up to 60 seconds; appointments receive a fresh availability check before saving."
msgstr "I calendari selezionati bloccano gli orari occupati. Una destinazione separata riceve gli appuntamenti Amelia quando il salvataggio è attivo. La visualizzazione degli orari può usare un risultato convalidato per un massimo di 60 secondi; la disponibilità degli appuntamenti viene verificata nuovamente prima del salvataggio."

#: hsp-calendar-connection.php:1422
msgid "The free/busy availability check passed."
msgstr "La verifica degli orari liberi e occupati è riuscita."

#: hsp-calendar-connection.php:1545
msgid "The selected destination passed create, update and cleanup checks."
msgstr "La destinazione selezionata ha superato le verifiche di creazione, aggiornamento e pulizia."

#: hsp-calendar-connection.php:1413
msgid "The server did not return a supported same-origin calendar address."
msgstr "Il server non ha restituito un indirizzo di calendario supportato con la stessa origine."

#: hsp-calendar-connection.php:1411
msgid "The server rejected authentication or access. Check the CalDAV credentials."
msgstr "Il server ha rifiutato l’autenticazione o l’accesso. Controlla le credenziali CalDAV."

#: hsp-calendar-connection.php:1412
msgid "The server requested a redirect. Redirects are disabled for this connection."
msgstr "Il server ha richiesto un reindirizzamento. I reindirizzamenti sono disattivati per questa connessione."

#: hsp-calendar-connection.php:1414
msgid "The server returned unsupported discovery data."
msgstr "Il server ha restituito dati di ricerca non supportati."

#: hsp-calendar-connection.php:1429
msgid "The temporary event could not be removed. Check the connection and retry cleanup."
msgstr "Non è stato possibile rimuovere l’evento temporaneo. Controlla la connessione e riprova la pulizia."

#: hsp-calendar-connection.php:1428
msgid "The temporary event was created and updated. Remove the test event to complete verification."
msgstr "L’evento temporaneo è stato creato e aggiornato. Rimuovi l’evento di prova per completare la verifica."

#: hsp-calendar-connection.php:1427
msgid "The write test could not be completed. If a temporary test is pending, remove it before trying again."
msgstr "Non è stato possibile completare il test di scrittura. Se è presente un test temporaneo in sospeso, rimuovilo prima di riprovare."

#: hsp-calendar-connection.php:1555
msgid "The write test creates and updates a temporary event containing no customer details. Remove it to finish verification."
msgstr "Il test di scrittura crea e aggiorna un evento temporaneo privo di dati del cliente. Rimuovilo per completare la verifica."

#: hsp-calendar-connection.php:1419
msgid "This login does not have write access to the chosen booking calendar."
msgstr "Questo account non dispone dell’accesso in scrittura al calendario di prenotazione scelto."

#: hsp-calendar-connection.php:1530 hsp-calendar-connection.php:1537
msgid "Unnamed calendar"
msgstr "Calendario senza nome"

#: hsp-calendar-connection.php:1492
msgid "Use the direct HTTPS CalDAV endpoint. Discovery stays on this server and port; redirects and private network addresses are blocked. Use a DNS hostname rather than an IPv6 literal."
msgstr "Usa l’indirizzo diretto dell’endpoint CalDAV HTTPS. La ricerca rimane limitata a questo server e a questa porta; i reindirizzamenti e gli indirizzi di rete privata sono bloccati. Usa un nome host DNS anziché un indirizzo IPv6 letterale."

#: hsp-calendar-connection.php:1539
msgid "Use the same CalDAV login for both. Appointment changes and cancellations are managed in Amelia."
msgstr "Usa lo stesso account CalDAV per entrambi. Le modifiche e le cancellazioni degli appuntamenti vengono gestite in Amelia."

#: hsp-calendar-connection.php:1540
msgid "Used for floating and all-day entries when the server does not publish a calendar timezone. A new connection starts with the WordPress site timezone."
msgstr "Usato per le voci senza fuso orario e per gli eventi di un’intera giornata quando il server non pubblica un fuso orario del calendario. Una nuova connessione usa inizialmente il fuso orario del sito WordPress."

#: hsp-calendar-connection.php:1604
msgid "Working hours and public booking availability are managed separately in Amelia."
msgstr "Gli orari di lavoro e la disponibilità pubblica per le prenotazioni sono gestiti separatamente in Amelia."
