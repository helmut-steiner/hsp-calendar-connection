msgstr "Le impostazioni di connessione, la selezione dei calendari e lo stato riportati di seguito riguardano %1$s."

#: hsp-calendar-connection.php:1406
msgid "Connection status"
msgstr "Stato della connessione"

#: hsp-calendar-connection.php:1455
msgid "Create an employee in Amelia before setting up a calendar connection."
msgstr "Crea un dipendente in Amelia prima di configurare una connessione al calendario."

#: hsp-calendar-connection.php:1540
msgid "Default calendar timezone"
msgstr "Fuso orario predefinito del calendario"

#: hsp-calendar-connection.php:1504
msgid "Discover calendars"
msgstr "Cerca calendari"

#: hsp-calendar-connection.php:1415
msgid "Discovery completed, but no calendar collections were found."
msgstr "La ricerca è completata, ma non sono state trovate raccolte di calendari."

