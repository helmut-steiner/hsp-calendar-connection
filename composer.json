{
  "name": "helmut-steiner/hsp-calendar-connection",
  "description": "Development checks for the HSP Calendar Connection WordPress plugin.",
  "license": "proprietary",
  "require-dev": {
    "squizlabs/php_codesniffer": "3.13.6",
    "wp-coding-standards/wpcs": "3.4.1",
    "phpcsstandards/phpcsutils": "1.2.3",
    "phpcsstandards/phpcsextra": "1.5.1"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  },
  "scripts": {
    "standards": "@php vendor/squizlabs/php_codesniffer/bin/phpcs --runtime-set installed_paths vendor/wp-coding-standards/wpcs,vendor/phpcsstandards/phpcsutils,vendor/phpcsstandards/phpcsextra --standard=phpcs.xml.dist",
    "test": "@php tests/run.php"
  }
}
