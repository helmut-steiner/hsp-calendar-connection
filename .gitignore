/build/
/dist/
*.zip
/.idea/
/.vscode/
/.phpunit.cache/
/.phpunit.result.cache
/.php-cs-fixer.cache
__pycache__/
*.pyc
/.phpcs-cache
.DS_Store
Thumbs.db
